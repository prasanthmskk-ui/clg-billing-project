# Frontend API URL
# Local development: leave empty to use the Vite proxy.
# Production on Vercel: set this to the deployed Render service URL, e.g.
# VITE_API_URL=https://clg-billing-backend.onrender.com
VITE_API_URL=

# Backend local development settings
BACKEND_PORT=5000
BACKEND_HOST=127.0.0.1

# Flask backend database settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billing_db
DB_USER=billing_user
DB_PASSWORD=
DB_CONNECTION_TIMEOUT=5

# Allowed CORS origins. In production, set this to your Vercel domain, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
# For local development, the Vite dev server uses these defaults:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173